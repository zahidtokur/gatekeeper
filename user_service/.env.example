# Example environment for this service inside Docker.
# Replace the development key before deploying.
DJANGO_SECRET_KEY=development-only-user_service-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,user-service

# Each service mounts its own volume at /data.
# When running locally, use an absolute path to a writable SQLite file.
DATABASE_PATH=/data/db.sqlite3
