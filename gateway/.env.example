# Example environment for this service inside Docker.
# Replace the development key before deploying.
DJANGO_SECRET_KEY=development-only-gateway-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gateway

# Each service mounts its own volume at /data.
# When running locally, use an absolute path to a writable SQLite file.
DATABASE_PATH=/data/db.sqlite3

# Docker DNS aliases; locally use localhost:8001 and localhost:8002.
USER_SERVICE_URL=http://user-service:8000
ORDER_SERVICE_URL=http://order-service:8000

# Redis is available only within the Docker network by default.
REDIS_URL=redis://redis:6379/0
